\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Warmup-skip sensitivity analysis. Left: baseline MDF per skip condition vs. stable settled reference (167.6\nobreakspace  {}Hz). Right: MDF change (\%) per condition. A 10-min skip produces $-$2.6\% (fatigue missed); 15-min produces $-$26.2\% (inverted); 20-min produces $+$28.1\% MDF decline (fatigue-consistent).\relax }}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:warmup}{{6}{11}{Warmup-skip sensitivity analysis. Left: baseline MDF per skip condition vs. stable settled reference (167.6~Hz). Right: MDF change (\%) per condition. A 10-min skip produces $-$2.6\% (fatigue missed); 15-min produces $-$26.2\% (inverted); 20-min produces $+$28.1\% MDF decline (fatigue-consistent).\relax }{figure.caption.11}{}}
\newlabel{fig:warmup@cref}{{[figure][6][]6}{[1][10][]11}}
