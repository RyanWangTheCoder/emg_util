\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Three-phase MDF trajectory in log0305 (63.1\nobreakspace  {}min, 626\nobreakspace  {}swings). Phase\nobreakspace  {}I (settling, 0--21\nobreakspace  {}min): MDF 115.7 $\pm $ 33.5\nobreakspace  {}Hz. Phase\nobreakspace  {}II (stable reference, 21--42\nobreakspace  {}min): MDF 167.6 $\pm $ 50.1\nobreakspace  {}Hz. Phase\nobreakspace  {}III (fatigue-consistent, 42--63\nobreakspace  {}min): MDF 149.5 $\pm $ 45.1\nobreakspace  {}Hz. IMU swing intensity remains flat across all phases ($r = +0.029$, $p = 0.468$). Warmup markers at 10/15/20\nobreakspace  {}min shown. \relax }}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:settling}{{5}{10}{Three-phase MDF trajectory in log0305 (63.1~min, 626~swings). Phase~I (settling, 0--21~min): MDF 115.7 $\pm $ 33.5~Hz. Phase~II (stable reference, 21--42~min): MDF 167.6 $\pm $ 50.1~Hz. Phase~III (fatigue-consistent, 42--63~min): MDF 149.5 $\pm $ 45.1~Hz. IMU swing intensity remains flat across all phases ($r = +0.029$, $p = 0.468$). Warmup markers at 10/15/20~min shown. \relax }{figure.caption.10}{}}
\newlabel{fig:settling@cref}{{[figure][5][]5}{[1][10][]10}}
